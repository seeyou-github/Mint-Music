<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义通知栏播放卡片（仅 Android）。

      ┌───────────────────────────────────────────┐
      │ ┌──────┐  歌名                        ✕   │
      │ │ 封面 │  ♡   ⏮   ⏯   ⏭   词              │
      │ └──────┘                                  │
      └───────────────────────────────────────────┘

  底色由 MintNotification 在运行时铺在根布局上（当前封面主色压暗，见
  `setAccentColor`），所以这里不写 background；普通文字 / 图标用浅色，「词」开启时用主题色。

  由 `MintNotification.java`（third_party/audio_service 里）填充图片与文字，
  并通过 RemoteViews 的 PendingIntent 绑定按钮，因此这里只写静态骨架：
  尺寸用 dp，字号用 sp。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mm_notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView
        android:id="@+id/mm_notif_cover"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/mm_notif_cover_empty" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="108dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mm_notif_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:paddingStart="11dp"
                android:textColor="#EDEDED"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/mm_notif_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/mm_ic_notif_close" />
        </LinearLayout>

        <!-- 收藏固定 42dp，心形左缘为 9dp 内边距 + 2dp 图形留白，与歌名对齐。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mm_notif_favorite"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@null"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/mm_ic_notif_heart_off" />

            <ImageView
                android:id="@+id/mm_notif_prev"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/mm_ic_notif_prev" />

            <ImageView
                android:id="@+id/mm_notif_play"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/mm_ic_notif_play" />

            <ImageView
                android:id="@+id/mm_notif_next"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/mm_ic_notif_next" />

            <TextView
                android:id="@+id/mm_notif_lyric"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="词"
                android:textColor="#E0E0E0"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
