/////////////////////////////////////////////////////////////////////////////
//
// Version
//

// 「文件版本 / 产品版本」显示成编译时间（北京时间），例如 2026.1110.0106，
// 这样从属性页就能看出手上的 exe 是哪一次编译产生的，不再永远是 pubspec 里的
// 2.0.0+1。
//
// build_stamp.h 由 windows/runner/CMakeLists.txt 在配置阶段调用
// tool/win_build_stamp.dart 生成到构建目录（固定按 UTC+8 计算，本地与 CI 一致），
// 通过 target_include_directories 找到；不要手写到这里，否则又变成固定值。
#include "build_stamp.h"

// 万一头文件没生成（不经过 CMake 的手工编译）：退回 pubspec 的语义化版本。
#ifndef APP_BUILD_STAMP
#if defined(FLUTTER_VERSION)
#define APP_BUILD_STAMP FLUTTER_VERSION
#else
#define APP_BUILD_STAMP "1.0.0"
#endif
#endif

#ifndef APP_FILE_VERSION
#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define APP_FILE_VERSION FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define APP_FILE_VERSION 1,0,0,0
#endif
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_FILE_VERSION
 PRODUCTVERSION APP_FILE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "com.kingmc.mintmusic" "\0"
            VALUE "FileDescription", "Music" "\0"
            VALUE "FileVersion", APP_BUILD_STAMP "\0"
            VALUE "InternalName", "Music" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 com.kingmc.mintmusic. All rights reserved." "\0"
            VALUE "OriginalFilename", "Music.exe" "\0"
            VALUE "ProductName", "Music" "\0"
            VALUE "ProductVersion", APP_BUILD_STAMP "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
